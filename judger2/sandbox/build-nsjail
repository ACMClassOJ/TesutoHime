#!/bin/bash

set -euo pipefail

source="https://github.com/google/nsjail"
revision=f100fd917c6d3ed0fd15d868528b735cb5fb1a1a
exe=nsjail
revision_file=.nsjail-revision

if [ -e "$exe" ] && [ -f "$revision_file" ] && [ "$(cat "$revision_file")" = "$revision" ]; then
  exit 0
fi

dir=$(mktemp -d "$PWD/.nsjail-build.XXXXXX")
trap 'rm -rf "$dir"' EXIT
git -C "$dir" init
git -C "$dir" remote add origin "$source"
git -C "$dir" fetch --depth 1 origin "$revision"
git -C "$dir" checkout --detach FETCH_HEAD
git -C "$dir" submodule update --init --recursive --depth 1
pushd "$dir" >/dev/null
make -j$(nproc)
strip "$exe"
cp "$exe" ../"$exe.new"
popd >/dev/null
mv "$exe.new" "$exe"
printf '%s\n' "$revision" > "$revision_file"
